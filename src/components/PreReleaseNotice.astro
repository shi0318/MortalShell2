---
// 发售状态提示条 —— 发售后保留 Beta/预告历史边界，不把它写成当前版本结论。
interface Props {
  compact?: boolean;
}
import { isReleased } from '../data/site';
const { compact = false } = Astro.props;
const released = isReleased();
---

<aside
  class:list={[
    'rounded-xl border border-amber-glow/20 bg-amber-glow/[0.06] text-ash-200 backdrop-blur-sm',
    compact ? 'px-3 py-2 text-xs' : 'px-4 py-3 text-sm',
  ]}
  role="note"
>
  <p>
    {released ? (
      <>
        <span class="font-semibold text-amber-glow">Available now.</span>
        Mortal Shell II released on August 20, 2026. This page keeps Open Beta, trailer, and
        prequel observations labelled as historical context; current retail guides are linked
        separately where the shipped build has been checked.
      </>
    ) : (
      <>
        <span class="font-semibold text-amber-glow">Pre-release guide.</span>
        Mortal Shell II launches on August 20, 2026. Facts below are marked with a confirmation
        status — anything based on trailers or the first game is flagged and will be replaced
        with verified data at launch.
      </>
    )}
  </p>
</aside>
