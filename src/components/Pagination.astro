---
interface Props {
  currentPage: number;
  totalPages: number;
  basePath: string;
}

const { currentPage, totalPages, basePath } = Astro.props;
const base = basePath.endsWith('/') ? basePath : `${basePath}/`;
const hrefFor = (page: number) => (page === 1 ? base : `${base}page/${page}/`);
---

{totalPages > 1 && (
  <nav aria-label="Guide pages" class="mt-10 flex flex-wrap items-center justify-center gap-2">
    {currentPage > 1 && (
      <a href={hrefFor(currentPage - 1)} rel="prev" class="rounded border border-white/15 px-4 py-2 text-sm text-ash-300 hover:border-amber-glow/60 hover:text-amber-glow">
        Previous
      </a>
    )}
    <ol class="flex flex-wrap items-center gap-2">
      {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
        <li>
          {page === currentPage ? (
            <span aria-current="page" class="inline-flex min-w-9 justify-center rounded border border-amber-glow bg-amber-glow px-3 py-2 text-sm font-bold text-ash-950">{page}</span>
          ) : (
            <a href={hrefFor(page)} class="inline-flex min-w-9 justify-center rounded border border-white/15 px-3 py-2 text-sm text-ash-300 hover:border-amber-glow/60 hover:text-amber-glow">{page}</a>
          )}
        </li>
      ))}
    </ol>
    {currentPage < totalPages && (
      <a href={hrefFor(currentPage + 1)} rel="next" class="rounded border border-white/15 px-4 py-2 text-sm text-ash-300 hover:border-amber-glow/60 hover:text-amber-glow">
        Next
      </a>
    )}
  </nav>
)}
