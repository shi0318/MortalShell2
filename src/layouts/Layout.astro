---
// 基础布局 —— 所有页面共用。负责 <head> meta、GA4、JSON-LD、Header、Footer。
import '../styles/global.css';
import { SITE } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AmbientParticles from '../components/AmbientParticles.astro';
import Schema from '../components/Schema.astro';
import { toDateString } from '../utils/dates';

interface Crumb {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  schemaType?: 'home' | 'article' | 'news' | 'collection';
  breadcrumb?: Crumb[];
  datePublished?: string | Date;
  dateModified?: string | Date;
  canonical?: string;
  noindex?: boolean;
  ogImage?: string;
  // full-bleed homepage / landing layouts
  fullWidth?: boolean;
}

const {
  title,
  description,
  schemaType = 'article',
  breadcrumb = [],
  datePublished,
  dateModified,
  canonical,
  noindex = false,
  ogImage = '/og-default.jpg',
  fullWidth = false,
} = Astro.props;

const path = Astro.url.pathname;
const isErrorPage = path.includes('404') || noindex;
const canonicalUrl = isErrorPage
  ? undefined
  : (canonical ?? new URL(path, SITE.url).href);
const ogImageUrl = new URL(ogImage, SITE.url).href;
const GA_ID = import.meta.env.PUBLIC_GA4_ID;
const published = toDateString(datePublished);
const modified = toDateString(dateModified);
const ogType = schemaType === 'article' || schemaType === 'news' ? 'article' : 'website';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="icon" href="/favicon-96.png" sizes="96x96" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="application-name" content={SITE.name} />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <Schema
      type={schemaType}
      path={path}
      title={title}
      description={description}
      breadcrumb={breadcrumb}
      datePublished={published || undefined}
      dateModified={modified || undefined}
      ogImage={ogImageUrl}
    />

    {
      GA_ID && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} />
          <script is:inline set:html={`
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', '${GA_ID}');
          `} />
        </>
      )
    }
  </head>
  <body class="flex min-h-screen flex-col">
    <AmbientParticles />
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-amber-glow focus:px-4 focus:py-2 focus:text-ash-950"
    >
      Skip to content
    </a>
    <Header />
    <main
      id="main"
      class:list={[
        'w-full flex-1',
        fullWidth ? '' : 'mx-auto max-w-6xl px-4 py-8 md:py-10',
      ]}
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>
