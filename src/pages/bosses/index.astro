---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { BOSSES } from '../../data/bosses';
const title = "Mortal Shell II Bosses: Encounters and Preparation Guides";
const description = "Find Mortal Shell II named encounters, relevant patch changes, achievement objectives and focused boss preparation guides without invented drop tables.";
const crumbs = [{name:'Home',url:'/'},{name:"Bosses",url:'/bosses/'}];
---
<Layout title={title} description={description} schemaType="collection" breadcrumb={crumbs}>
<Breadcrumb items={crumbs} />
<img src="/images/mortalshell2-cathedral-guardian-boss.webp" alt="Mortal Shell II bosses overview" width="1600" height="900" class="my-6 rounded-xl" loading="eager" decoding="async" /><header class="max-w-3xl"><h1 class="text-3xl font-bold text-ash-100">Mortal Shell II Bosses: Encounters and Preparation Guides</h1><p class="mt-4 text-ash-300">Choose an encounter to see its documented patch context and the guide relevant to your goal. This is an encounter index, not a complete boss-health or loot database. Historical fixes are labelled as changes in their update; they do not promise every current save is free of an issue.</p></header>
<div class="mt-7 mb-8 flex flex-wrap gap-3">{BOSSES.map(item => <a class="text-amber-glow underline" href={`#${item.slug}`}>{item.name}</a>)}</div>
<p class="mb-7 text-ash-300">Use <a class="text-amber-glow underline" href="/mortal-shell-2-boss-preparation-guide/">boss preparation</a> for loadout, runback and attack-window decisions. <a class="text-amber-glow underline" href="/mortal-shell-2-missable-achievements/">Tar Golem and the Nameless Captive action objectives</a> deserve a separate check before advancing. The <a class="text-amber-glow underline" href="/mammon-second-visit-survival-route/">Mammon return route</a> addresses exploration pressure rather than a universal boss order.</p>
<div class="grid gap-6 md:grid-cols-2">{BOSSES.map(item => <section id={item.slug} class="surface-card p-6 scroll-mt-24"><h2 class="text-xl font-semibold text-ash-100">{item.name}</h2><p class="mt-3 text-ash-300">{item.note}</p><p class="mt-3"><a class="text-amber-glow underline" href="/mortal-shell-2-boss-preparation-guide/">Arena route and combat preparation</a> · <a class="text-amber-glow underline" href="/mortal-shell-2-missable-achievements/">Missable actions</a></p></section>)}</div>
<p class="mt-10 text-ash-300"><a href="/guide/" class="text-amber-glow underline">Browse all gameplay guides</a> · <a href="/mortal-shell-2-achievements/" class="text-amber-glow underline">Full achievement conditions</a></p>
</Layout>
