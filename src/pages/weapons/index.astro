---
import Layout from '../../layouts/Layout.astro';
import MediaFigure from '../../components/MediaFigure.astro';
import { SITE_IMAGES } from '../../data/images';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { MELEE_WEAPONS, SIDEARMS, UPGRADE_LADDER, MELEE_TIERS, SIDEARM_TIERS } from '../../data/loadout';

const title = 'Mortal Shell 2 Weapons — 8 Melee, 8 Sidearms, Locations and Upgrades';
const description =
  'Mortal Shell 2 weapons guide: eight melee weapons, eight sidearms, Tarforge upgrades to +16, Merrick maps, and a player-consensus tier list.';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Weapons', url: '/weapons/' },
];
---

<Layout title={title} description={description} schemaType="collection" breadcrumb={crumbs}>
  <Breadcrumb items={crumbs} />

  <header class="mb-8">
    <h1 class="text-3xl font-bold tracking-tight text-ash-100 md:text-4xl">Mortal Shell 2 Weapons Guide</h1>
    <p class="mt-3 max-w-2xl text-lg text-ash-400">
      You always carry one melee weapon and one sidearm. There are eight of each. Pickup locations, Tarforge
      materials, and the player-consensus ranking below are walkthrough notes for this wiki — damage numbers
      on the HUD are not a published stat sheet.
    </p>
  </header>

  <div class="mb-8">
    <MediaFigure
      src={SITE_IMAGES.weaponsCloseup.src}
      alt={SITE_IMAGES.weaponsCloseup.alt}
      width={SITE_IMAGES.weaponsCloseup.width}
      height={SITE_IMAGES.weaponsCloseup.height}
    />
  </div>

  <section class="prose-body mb-10 max-w-3xl space-y-3 text-ash-300">
    <h2 class="text-xl font-semibold text-ash-100">How the loadout works</h2>
    <p>
      Combat is Resolve and posture, not a stamina bar. Weapons stay unlocked once found and can move between
      Shells. Tarstones are infusions, not smithing stones. Merrick in Marrow Keep sells maps that mark weapon
      pins if you would rather spend Coins than explore.
    </p>
  </section>

  <h2 class="mb-4 text-xl font-semibold text-ash-100">Melee weapons</h2>
  <div class="mb-10 overflow-x-auto surface-card">
    <table class="w-full min-w-[48rem] border-collapse text-sm">
      <thead class="bg-ash-900 text-left text-ash-300">
        <tr>
          <th class="px-4 py-3 font-semibold">Look</th>
          <th class="px-4 py-3 font-semibold">Weapon</th>
          <th class="px-4 py-3 font-semibold">Feel</th>
          <th class="px-4 py-3 font-semibold">Where to get it</th>
          <th class="px-4 py-3 font-semibold">Achievement</th>
        </tr>
      </thead>
      <tbody>
        {
          MELEE_WEAPONS.map((w) => (
            <tr class="border-t border-white/5 align-top">
              <td class="px-4 py-3">
                <img src={w.image} alt={w.name} width="120" height="120" loading="lazy" decoding="async" class="h-20 w-20 rounded object-cover" />
              </td>
              <td class="px-4 py-3 font-medium text-ash-100">
                {w.slug ? (
                  <a href={`/weapons/${w.slug}/`} class="text-amber-glow hover:underline">
                    {w.name}
                  </a>
                ) : (
                  w.name
                )}
              </td>
              <td class="px-4 py-3 text-ash-400">{w.feel}</td>
              <td class="px-4 py-3 text-ash-300">{w.location}</td>
              <td class="px-4 py-3 text-ash-400">{w.achievement}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2 class="mb-4 text-xl font-semibold text-ash-100">Sidearms</h2>
  <div class="mb-10 overflow-x-auto surface-card">
    <table class="w-full min-w-[48rem] border-collapse text-sm">
      <thead class="bg-ash-900 text-left text-ash-300">
        <tr>
          <th class="px-4 py-3 font-semibold">Look</th>
          <th class="px-4 py-3 font-semibold">Sidearm</th>
          <th class="px-4 py-3 font-semibold">Feel</th>
          <th class="px-4 py-3 font-semibold">Where to get it</th>
          <th class="px-4 py-3 font-semibold">Achievement</th>
        </tr>
      </thead>
      <tbody>
        {
          SIDEARMS.map((w) => (
            <tr class="border-t border-white/5 align-top">
              <td class="px-4 py-3">
                <img src={w.image} alt={w.name} width="120" height="120" loading="lazy" decoding="async" class="h-20 w-20 rounded object-cover" />
              </td>
              <td class="px-4 py-3 font-medium text-ash-100">
                {w.slug ? (
                  <a href={`/weapons/${w.slug}/`} class="text-amber-glow hover:underline">
                    {w.name}
                  </a>
                ) : (
                  w.name
                )}
              </td>
              <td class="px-4 py-3 text-ash-400">{w.feel}</td>
              <td class="px-4 py-3 text-ash-300">{w.location}</td>
              <td class="px-4 py-3 text-ash-400">{w.achievement}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <section class="prose-body mb-10 max-w-3xl space-y-4 text-ash-300">
    <h2 class="text-xl font-semibold text-ash-100">Tarforge levels</h2>
    <p>
      Upgrade at the Tarforge in Marrow Keep. Cap for a first playthrough is +16. Materials climb
      Ventrium (+1 to +6), Laterite (+7 to +11), then Dorsalite (+12 to +16), plus Coins. Each step is
      about +5% damage (105% at +1, 180% at +16 on the Iconoclast table). Troubador's Lute cannot be
      upgraded. Smelting later refunds spent stones. Players also report a late-game item that goes past
      +16 — treat +16 as the advertised cap until you find that chest.
    </p>
    <div class="overflow-x-auto">
      <table class="w-full min-w-[28rem] border-collapse text-sm">
        <thead class="bg-ash-900 text-left text-ash-300">
          <tr>
            <th class="px-4 py-3 font-semibold">Level</th>
            <th class="px-4 py-3 font-semibold">Damage</th>
            <th class="px-4 py-3 font-semibold">Material</th>
            <th class="px-4 py-3 font-semibold">Coins</th>
          </tr>
        </thead>
        <tbody>
          {
            UPGRADE_LADDER.map((row) => (
              <tr class="border-t border-white/5">
                <td class="px-4 py-2 text-ash-100">{row.level}</td>
                <td class="px-4 py-2 text-ash-300">{row.damage}</td>
                <td class="px-4 py-2 text-ash-400">{row.material}</td>
                <td class="px-4 py-2 text-ash-400">{row.coins}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="text-sm text-ash-500">
      Iconoclast ladder as measured in play. Other melee weapons match through at least +9. Sidearm
      stone counts are not fully mapped.
    </p>
  </section>

  <section class="prose-body max-w-3xl space-y-4 text-ash-300">
    <h2 class="text-xl font-semibold text-ash-100">Player ranking</h2>
    <p>
      Not a developer list. Axatana and Black Needle sit at the top of most player write-ups. Obsidian
      Hammer sits at the bottom because it is slow. Patches and Shells will move this around.
    </p>
    <h3 class="text-lg font-semibold text-ash-100">Melee</h3>
    <ul class="list-disc space-y-1 pl-5">
      {MELEE_TIERS.map((row) => (
        <li>
          <strong class="text-ash-100">{row.tier} — {row.name}.</strong> {row.why}
        </li>
      ))}
    </ul>
    <h3 class="text-lg font-semibold text-ash-100">Sidearms</h3>
    <ul class="list-disc space-y-1 pl-5">
      {SIDEARM_TIERS.map((row) => (
        <li>
          <strong class="text-ash-100">{row.tier} — {row.name}.</strong> {row.why}
        </li>
      ))}
    </ul>
  </section>
</Layout>
