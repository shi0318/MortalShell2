---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { WEAPONS } from '../../data/weapons';
const title = "Mortal Shell II Weapons: Unlock Index and Upgrade Guides";
const description = "Browse Mortal Shell II weapon unlock conditions, documented patch changes, Sidearm context and Tarforge upgrade advice without an unsupported tier list.";
const crumbs = [{name:'Home',url:'/'},{name:"Weapons",url:'/weapons/'}];
---
<Layout title={title} description={description} schemaType="collection" breadcrumb={crumbs}>
<Breadcrumb items={crumbs} />
<img src="/images/mortalshell2-shell-greatsword-closeup.webp" alt="Mortal Shell II weapons overview" width="1600" height="900" class="my-6 rounded-xl" loading="eager" decoding="async" /><header class="max-w-3xl"><h1 class="text-3xl font-bold text-ash-100">Mortal Shell II Weapons: Unlock Index and Upgrade Guides</h1><p class="mt-4 text-ash-300">Use this index to identify an item and its achievement condition, then open the comparison guide for its documented patch changes. Individual unlock achievements are not a complete weapon-versus-Sidearm classification or a power ranking. A name in patch notes without a dedicated unlock achievement is kept separately in the same index.</p></header>
<div class="mt-7 mb-8 flex flex-wrap gap-3">{WEAPONS.map(item => <a class="text-amber-glow underline" href={`#${item.slug}`}>{item.name}</a>)}</div>
<p class="mb-7 text-ash-300">Start with <a class="text-amber-glow underline" href="/mortal-shell-2-best-weapon/">the weapon comparison guide</a> for reach, recovery, buffs and resource costs. Use <a class="text-amber-glow underline" href="/rotten-autumn-tarstone-build-reset/">Tarstone resets</a> for that separate build system. Exact unverified pickup coordinates, +16 material ladders and a purported player-consensus tier ranking have been removed from this index. Their absence does not mean the items have no acquisition routes; it means this index does not present an unsupported route as established fact.</p>
<div class="grid gap-6 md:grid-cols-2">{WEAPONS.map(item => <section id={item.slug} class="surface-card p-6 scroll-mt-24"><h2 class="text-xl font-semibold text-ash-100">{item.name}</h2><p class="mt-3 text-ash-300">{item.condition}</p>{item.achievement && <p class="mt-3 text-ash-400">Achievement: {item.achievement}</p>}<p class="mt-3"><a class="text-amber-glow underline" href="/mortal-shell-2-best-weapon/#weapon-changes-worth-knowing">Documented weapon changes</a> · <a class="text-amber-glow underline" href="/mortal-shell-2-best-weapon/#tarforge-upgrades-and-switching-weapons">Tarforge and comparisons</a></p></section>)}</div>
<p class="mt-10 text-ash-300"><a href="/guide/" class="text-amber-glow underline">Browse all gameplay guides</a> · <a href="/mortal-shell-2-achievements/" class="text-amber-glow underline">Full achievement conditions</a></p>
</Layout>
