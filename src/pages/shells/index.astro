---
import Layout from '../../layouts/Layout.astro';
import MediaFigure from '../../components/MediaFigure.astro';
import { SITE_IMAGES } from '../../data/images';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { SHELLS, SHELL_BONDING } from '../../data/shells';
import { SHELL_FIND, HARROS_PROLOGUE } from '../../data/shell-routes';

const title = 'Mortal Shell 2 Shells — Harros Prologue and All 8 Unlock Routes';
const description =
  'Mortal Shell 2 shells: Harros is prologue-only, then eight swappable shells with locations, Bond tiers, and how to get Genessa.';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Shells', url: '/shells/' },
];
---

<Layout title={title} description={description} schemaType="collection" breadcrumb={crumbs}>
  <Breadcrumb items={crumbs} />

  <div class="mb-8">
    <MediaFigure
      src={SITE_IMAGES.shellsPortrait.src}
      alt={SITE_IMAGES.shellsPortrait.alt}
      width={SITE_IMAGES.shellsPortrait.width}
      height={SITE_IMAGES.shellsPortrait.height}
    />
  </div>

  <header class="mt-4 max-w-3xl">
    <h1 class="text-3xl font-bold tracking-tight text-ash-100 md:text-4xl">Mortal Shell 2 Shells Guide</h1>
    <p class="mt-3 text-lg text-ash-400">
      Nine named bodies, eight you keep. Harros teaches the loop and is destroyed after Tar Golem. The
      eight below swap at Zhirelle. Bond caps at {SHELL_BONDING.maxTier}. Glimpses are no longer finite
      after the Week 1 update; Merrick sells Mether's Severance to respec.
    </p>
  </header>

  <section class="prose-body mt-10 max-w-3xl space-y-3 text-ash-300">
    <h2 class="text-xl font-semibold text-ash-100">{HARROS_PROLOGUE.name}</h2>
    <p>{HARROS_PROLOGUE.how}</p>
    <p>{HARROS_PROLOGUE.kit}</p>
    <p>{HARROS_PROLOGUE.fate}</p>
  </section>

  <div class="mt-10 overflow-x-auto surface-card">
    <table class="w-full min-w-[48rem] border-collapse text-sm">
      <thead>
        <tr class="border-b border-ash-700 bg-ash-900/50 text-left text-ash-400">
          <th class="px-4 py-3 font-medium">Shell</th>
          <th class="px-4 py-3 font-medium">Role</th>
          <th class="px-4 py-3 font-medium">How to get it</th>
          <th class="px-4 py-3 font-medium">Notes</th>
        </tr>
      </thead>
      <tbody>
        {
          SHELL_FIND.map((shell) => (
            <tr class="border-b border-white/5 align-top last:border-0">
              <td class="px-4 py-3 font-semibold text-ash-100">
                <a href={shell.href} class="text-amber-glow hover:underline">
                  {shell.name}
                </a>
              </td>
              <td class="px-4 py-3 text-ash-400">{shell.role}</td>
              <td class="px-4 py-3 text-ash-300">{shell.how}</td>
              <td class="px-4 py-3 text-ash-400">{shell.extra}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <section class="prose-body mt-10 max-w-3xl space-y-4 text-ash-300">
    <h2 class="text-xl font-semibold text-ash-100">Bond and Glimpses</h2>
    <p>
      Max Bond is {SHELL_BONDING.maxTier}, about {SHELL_BONDING.glimpsesPerShell} Glimpses per Shell.
      Seeking the Past wants that on all eight. {SHELL_BONDING.economyChange}
    </p>
    <h2 class="text-xl font-semibold text-ash-100">Unlock rates</h2>
    <p>
      Steam snapshot from 1 September 2026, useful as find-order, not as a ranking:
      {SHELLS.map((s) => `${s.name.split(',')[0]} ${s.unlockRate}%`).join(' · ')}.
    </p>
  </section>
</Layout>
