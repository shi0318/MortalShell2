---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { SHELLS } from '../../data/shells';
const title = "Mortal Shell II Shells: Roster and Build Guide";
const description = "Find the eight Mortal Shell II Shells, their published unlock conditions, documented abilities and the respec and quest guides relevant to each build.";
const crumbs = [{name:'Home',url:'/'},{name:"Shells",url:'/shells/'}];
---
<Layout title={title} description={description} schemaType="collection" breadcrumb={crumbs}>
<Breadcrumb items={crumbs} />
<img src="/images/mortalshell2-official-keyart-3.webp" alt="Mortal Shell II shells overview" width="1600" height="900" class="my-6 rounded-xl" loading="eager" decoding="async" /><header class="max-w-3xl"><h1 class="text-3xl font-bold text-ash-100">Mortal Shell II Shells: Roster and Build Guide</h1><p class="mt-4 text-ash-300">Browse the eight playable Shells by name. Unlock conditions come from the current achievement record; named abilities come from developer patch notes, with the two quest routes below explicitly described as community guidance. The list is not a strength ranking or an acquisition order.</p></header>
<div class="mt-7 mb-8 flex flex-wrap gap-3">{SHELLS.map(item => <a class="text-amber-glow underline" href={`#${item.slug}`}>{item.name}</a>)}</div>
<p class="mb-7 text-ash-300"><a class="text-amber-glow underline" href="/shell-selection-guide/">Shell selection and Mether’s Severance</a> explains how to choose for a concrete obstacle. <a class="text-amber-glow underline" href="/beginner-guide/">The beginner guide</a> covers the first-session equipment loop. Harros is discussed as historical prologue context, not added as a ninth permanent unlock. <span id="harros">The current Tar Golem condition and its timing objective are covered by the missable guide.</span></p>
<div class="grid gap-6 md:grid-cols-2">{SHELLS.map(item => <section id={item.slug} class="surface-card p-6 scroll-mt-24"><h2 class="text-xl font-semibold text-ash-100">{item.name}</h2><p class="mt-3 text-ash-300">{item.note}</p><p class="mt-3 text-ash-400">Achievement: {item.achievement} — {item.condition}.</p><p class="mt-3"><a class="text-amber-glow underline" href="/shell-selection-guide/">Compare abilities and respec a Shell</a></p></section>)}</div>
<p class="mt-10 text-ash-300"><a href="/guide/" class="text-amber-glow underline">Browse all gameplay guides</a> · <a href="/mortal-shell-2-achievements/" class="text-amber-glow underline">Full achievement conditions</a></p>
</Layout>
