---
// 工具聚合页：只收录当前已有实际内容的路线、装备证据、地图和 PC 排查入口。
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const title = 'Mortal Shell II Tools — PC Diagnosis, Map and Completion Checks';
const description =
  'Practical Mortal Shell II references for PC diagnosis, Beacon progress, route planning, Tarstone resets, achievements and New Game Plus decisions.';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Tools', url: '/tools/' },
];

const tools = [
 {href:'/pc-requirements/',label:'PC diagnosis',title:'Requirements and troubleshooting',description:'Compare the published hardware requirements, then investigate shader hitches, crowded-area slowdowns and display changes.'},
 {href:'/beacons/',label:'Checkpoint progress',title:'Beacon cleansing and travel checks',description:'Distinguish discovery, cleansing, travel access and an unavailable upgrade before repeating a route.'},
 {href:'/map/',label:'Navigation',title:'Map and route planning',description:'Plan a return route, compare elevations and decide when to enter an optional dungeon.'},
 {href:'/mortal-shell-2-achievements/',label:'Completion reference',title:'All published achievement conditions',description:'Find the exact 53 Steam conditions, separate collection goals and check a special action before another cycle.'},
 {href:'/rotten-autumn-tarstone-build-reset/',label:'Build changes',title:'Tarstone reset workflow',description:'Use the documented Rotten Autumn changes to reset the Tarstone part of a build, separately from a Shell bond.'},
 {href:'/mortal-shell-2-ng-plus-checklist/',label:'Before advancing',title:'New Game Plus checklist',description:'Check current objectives and unfinished decisions before choosing another campaign cycle.'},
];
---

<Layout title={title} description={description} schemaType="collection" breadcrumb={crumbs}>
  <Breadcrumb items={crumbs} />

  <header class="mb-8">
    <p class="section-kicker">Practical references</p>
    <h1 class="section-title mt-3 md:text-5xl">Mortal Shell 2 Tools</h1>
    <p class="mt-3 max-w-3xl text-lg text-ash-400">
      Choose the task you are working on in the released Mortal Shell II. These references connect the current system, its documented changes and the next action to check.
    </p>
  </header>

  <section class="grid gap-5 md:grid-cols-2" aria-label="Mortal Shell 2 tools">
    {tools.map((tool) => (
      <a href={tool.href} class="surface-card group block p-5 transition-colors hover:border-amber-glow/30">
        <p class="section-kicker">{tool.label}</p>
        <h2 class="mt-2 text-xl font-semibold text-ash-100 group-hover:text-amber-glow">{tool.title}</h2>
        <p class="mt-2 text-sm leading-relaxed text-ash-400">{tool.description}</p>
        <span class="mt-4 inline-flex text-sm font-medium text-amber-glow">Open tool →</span>
      </a>
    ))}
  </section>

  <section class="surface-card mt-10 p-6 md:p-8">
    <p class="section-kicker">Build planning</p>
    <h2 class="section-title mt-3">Choose the right part of your build</h2>
    <p class="mt-3 max-w-3xl text-ash-400">
      Shell bonding, Tarstone upgrades and weapon smelting are different systems. A Shell respec does not reset every part of a loadout. If you are changing equipment, begin with the relevant system and keep the rest constant while comparing the result.
    </p>
  </section>
</Layout>
