---
// 工具聚合页：只收录当前已有实际内容的路线、装备证据、地图和 PC 排查入口。
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const title = 'Mortal Shell II Tools — PC Requirements, Map & Launch Checks';
const description =
  'Mortal Shell II tools for PC requirements, launch checks, map notes, weapons evidence, Shell roster and archived Open Beta performance reports.';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Tools', url: '/tools/' },
];

const tools = [
  {
    href: '/mortal-shell-ii-open-beta-walkthrough/',
    label: 'Route checklist',
    title: 'Open Beta Walkthrough',
    description: 'Track the Prologue, first region, Tiel, Beacons, optional dungeons, challenges and Marrow Keep.',
  },
  {
    href: '/mortal-shell-ii-open-beta-weapons-guide/',
    label: 'Weapons evidence',
    title: 'Open Beta Weapons Guide',
    description: 'Review the confirmed Axe-and-Dagger objective and separate Beta evidence from unverified retail stats.',
  },
  {
    href: '/shells/',
    label: 'Shell roster',
    title: 'Verified Shells Tracker',
    description: 'Compare the Shell information that official Open Beta and reveal material currently confirm.',
  },
  {
    href: '/map/',
    label: 'Route map',
    title: 'Known Regions Map',
    description: 'Use the current official region, Beacon, Shell and route notes without treating the Beta-era map as a complete retail map.',
  },
  {
    href: '/mortal-shell-2-beta-performance-fixes/',
    label: 'PC checks',
    title: 'Beta Performance Checks',
    description: 'Work through official requirements and public reports about crashes, stutter and camera problems.',
  },
];
---

<Layout title={title} description={description} schemaType="collection" breadcrumb={crumbs}>
  <Breadcrumb items={crumbs} />

  <header class="mb-8">
    <p class="section-kicker">Play while you check</p>
    <h1 class="section-title mt-3 md:text-5xl">Mortal Shell 2 Tools</h1>
    <p class="mt-3 max-w-3xl text-lg text-ash-400">
      These tools are deliberately small and evidence-led. Each one answers a task you can act on in
      the released Mortal Shell II instead of presenting an unverified database full of empty fields.
    </p>
  </header>

  <section class="grid gap-5 md:grid-cols-2" aria-label="Mortal Shell 2 tools">
    {tools.map((tool) => (
      <a href={tool.href} class="surface-card group block p-5 transition-colors hover:border-amber-glow/30">
        <p class="section-kicker">{tool.label}</p>
        <h2 class="mt-2 text-xl font-semibold text-ash-100 group-hover:text-amber-glow">{tool.title}</h2>
        <p class="mt-2 text-sm leading-relaxed text-ash-400">{tool.description}</p>
        <span class="mt-4 inline-flex text-sm font-medium text-amber-glow">Open tool →</span>
      </a>
    ))}
  </section>

  <section class="surface-card mt-10 p-6 md:p-8">
    <p class="section-kicker">Evidence boundary</p>
    <h2 class="section-title mt-3">What these tools do not invent</h2>
    <p class="mt-3 max-w-3xl text-ash-400">
      Beta pages remain historical evidence. Exact retail weapon locations, final Shell stats,
      complete boss order and full-game completion time are added only when the current build or a
      repeatable source verifies them.
    </p>
  </section>
</Layout>
