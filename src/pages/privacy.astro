---
// 隐私政策 —— AdSense 条件（8.1）：说明 Cookie、数据收集、第三方服务（GA4）。
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE } from '../data/site';

const title = 'Privacy Policy — Mortal Shell II Wiki';
const description =
  'How Mortal Shell II Wiki handles cookies, analytics, and third-party services. What we collect, why, and the choices you have.';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Privacy Policy', url: '/privacy/' },
];

const updated = '2026-07-23';
---

<Layout title={title} description={description} schemaType="article" breadcrumb={crumbs}>
  <article class="mx-auto max-w-3xl">
    <Breadcrumb items={crumbs} />

    <h1 class="text-3xl font-bold tracking-tight text-ash-100 md:text-4xl">Privacy Policy</h1>
    <p class="mt-2 text-sm text-ash-500">Last updated <time datetime={updated}>{updated}</time></p>

    <div class="prose-body mt-8 space-y-6 text-ash-200">
      <p>
        This policy explains what data {SITE.name} collects and how it is used. We keep it
        short and specific — no boilerplate we don't actually rely on.
      </p>

      <section>
        <h2 class="text-xl font-semibold text-ash-100">Analytics</h2>
        <p class="mt-2">
          We use Google Analytics 4 to understand which guides are useful and where readers
          run into trouble. GA4 sets cookies and collects anonymised usage data such as pages
          visited, approximate region, device type, and session duration. We do not collect
          your name, email, or any information that identifies you personally through
          analytics.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-ash-100">Cookies</h2>
        <p class="mt-2">
          Cookies on this site come from the analytics and, in future, advertising services
          named here. You can block or delete cookies in your browser settings; the site
          continues to work without them. Where required, a consent banner lets you choose
          before non-essential cookies are set.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-ash-100">Advertising</h2>
        <p class="mt-2">
          If and when we display ads (for example, Google AdSense), the ad provider may use
          cookies to serve and measure ads. This section will be updated with the specific
          provider and its policy link before any ads go live. Any sponsored link on this
          site is marked with <code>rel="sponsored"</code>.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-ash-100">Third-party links</h2>
        <p class="mt-2">
          We link to official sources (developer posts, Steam, trailers) so you can verify
          our facts. Those sites have their own privacy policies, which we don't control.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-ash-100">Contact</h2>
        <p class="mt-2">
          Questions about this policy? Email
          <a
            href={`mailto:${SITE.contactEmail}`}
            class="text-amber-glow underline underline-offset-2"
          >
            {SITE.contactEmail}
          </a>.
        </p>
      </section>
    </div>
  </article>
</Layout>
