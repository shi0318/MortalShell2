---
// 攻略聚合页 — CollectionPage schema（方案 3.1：列表页不标 Article）。
// 卡片式列表：缩略图 + 分类标签 + 日期 + 摘要，对齐竞品列表页体验。
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PreReleaseNotice from '../../components/PreReleaseNotice.astro';
import GuideCard from '../../components/GuideCard.astro';
import Pagination from '../../components/Pagination.astro';
import { getCollection } from 'astro:content';
import { SITE_IMAGES } from '../../data/images';
import { formatDate } from '../../utils/dates';

const title = 'Mortal Shell II Guides — Verified Pre-release Hub';
const description =
  'Browse every Mortal Shell II guide on this wiki: Open Beta, release date, Shells, beacons, Gloom, map, and PC requirements — each page tagged with a confirmation status.';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Guide', url: '/guide/' },
];

const CATEGORY_LABEL: Record<string, string> = {
  guide: 'Overview',
  mechanics: 'Mechanics',
  shells: 'Shells',
  weapons: 'Weapons',
  bosses: 'Bosses',
  walkthrough: 'Walkthrough',
  news: 'News',
};

// fallback covers if a guide has no frontmatter cover
const FALLBACK_COVER: Record<string, string> = {
  guide: SITE_IMAGES.heroCombat.src,
  mechanics: SITE_IMAGES.gloomCreature.src,
  shells: SITE_IMAGES.shellsPortrait.src,
  weapons: SITE_IMAGES.weaponsCloseup.src,
  bosses: SITE_IMAGES.cathedralBoss.src,
  walkthrough: SITE_IMAGES.heroBanner.src,
  news: SITE_IMAGES.officialKeyart2.src,
};

const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.updatedAt.localeCompare(a.data.updatedAt) || a.id.localeCompare(b.id),
);
const PAGE_SIZE = 9;
const currentPage = 1;
const totalPages = Math.ceil(guides.length / PAGE_SIZE);
const visibleGuides = guides.slice(0, PAGE_SIZE);

function coverOf(g: (typeof guides)[number]) {
  return g.data.cover ?? FALLBACK_COVER[g.data.category] ?? SITE_IMAGES.heroCombat.src;
}

function labelOf(cat: string) {
  return CATEGORY_LABEL[cat] ?? cat;
}

function cardAlt(g: (typeof guides)[number]) {
  const name = g.data.heading ?? g.data.title;
  return `${name} cover image`;
}
---

<Layout title={title} description={description} schemaType="collection" breadcrumb={crumbs}>
  <Breadcrumb items={crumbs} />

  <header class="mb-8">
    <p class="section-kicker">Start here</p>
    <h1 class="section-title mt-3 md:text-5xl">
      Verified Mortal Shell II guides
    </h1>
    <p class="mt-3 max-w-2xl text-lg text-ash-400">
      Pre-release pages only. Every card shows a confirmation status and a last-verified date
      so you can tell official Steam notes from trailer clues or prequel inference.
    </p>
  </header>

  <div class="mb-8"><PreReleaseNotice /></div>

  <section class="latest-guides" aria-label="Latest guides">
    <p class="section-kicker">Latest guides first</p>
    <h2 class="section-title mt-2 mb-5 md:text-3xl">New and recently updated</h2>
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {visibleGuides.map((g) => (
        <GuideCard
          href={`/${g.id}/`}
          title={g.data.heading ?? g.data.title}
          description={g.data.description}
          cover={coverOf(g)}
          label={labelOf(g.data.category)}
          verified={formatDate(g.data.updatedAt)}
          status={g.data.status}
        />
      ))}
    </ul>
    <Pagination currentPage={currentPage} totalPages={totalPages} basePath="/guide/" />
  </section>
</Layout>
