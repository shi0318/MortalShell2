---
// 首页 —— 沉浸式 field-guide 布局（参考舒适型暗色 wiki 的节奏与层次）
import Layout from '../layouts/Layout.astro';
import Countdown from '../components/Countdown.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { SITE, isReleased } from '../data/site';
import { SHELLS } from '../data/shells';
import { BOSSES } from '../data/bosses';
import MediaFigure from '../components/MediaFigure.astro';
import { SITE_IMAGES } from '../data/images';

const released = isReleased();

const title = 'Mortal Shell 2 Wiki Guide — Shells, Bosses, Weapons & Release Date';
const description =
  'Independent Mortal Shell 2 wiki and guide: Shells, bosses, weapons, Open Beta access, PC settings, and the August 20 release date. Every fact carries a confirmation status.';

const categories = [
  {
    href: '/download/',
    title: 'Download',
    desc: 'Official Steam Open Beta install only. No third-party files.',
    count: null as number | null,
    countLabel: '',
  },
  {
    href: '/shells/',
    title: 'Shells',
    desc: 'Eight-Shell roster tracker with Official and prequel-labelled entries.',
    count: SHELLS.length,
    countLabel: 'Shells tracked',
  },
  {
    href: '/weapons/',
    title: 'Weapons',
    desc: 'Pre-release arsenal tracker. Confirmed notes only; no invented stats.',
    count: null,
    countLabel: '',
  },
  {
    href: '/bosses/',
    title: 'Bosses',
    desc: 'Named encounters and mini-bosses tracked before full strategy pages.',
    count: BOSSES.length,
    countLabel: 'Bosses tracked',
  },
];

const startHere = [
  {
    href: '/release-date/',
    title: 'Release Date (Aug 20, 2026)',
    desc: 'Confirmed platforms, current Open Beta status, and what to do before launch day.',
    cover: SITE_IMAGES.officialKeyart1.src,
  },
  {
    href: '/beginner-guide/',
    title: 'Beginner First Hours',
    desc: 'Official Open Beta route priorities: Prologue, beacons, Tiel, Marrow Keep, Magdalena.',
    cover: SITE_IMAGES.heroCombat.src,
  },
  {
    href: '/download/',
    title: 'Download Open Beta',
    desc: 'Official Steam install link, system requirements check, and first steps after download.',
    cover: SITE_IMAGES.weaponsCloseup.src,
  },
  {
    href: '/editions/',
    title: 'Devout vs Revered Editions',
    desc: 'Obsidian skins, 72-hour early access, and PS5 collector contents from official pages.',
    cover: SITE_IMAGES.officialKeyart2.src,
  },
];
---

<Layout title={title} description={description} schemaType="home" fullWidth>
  <!-- Full-bleed immersive hero -->
  <section class="relative isolate min-h-[78vh] overflow-hidden border-b border-white/5">
    <div class="absolute inset-0">
      <img
        src={SITE_IMAGES.heroBanner.src}
        alt={SITE_IMAGES.heroBanner.alt}
        width={SITE_IMAGES.heroBanner.width}
        height={SITE_IMAGES.heroBanner.height}
        loading="eager"
        decoding="sync"
        fetchpriority="high"
        class="h-full w-full object-cover object-center"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-ash-950/55 via-ash-950/70 to-ash-950"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-ash-950/75 via-ash-950/35 to-ash-950/55"></div>
      <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-ash-950 to-transparent"></div>
    </div>

    <div class="relative mx-auto flex min-h-[78vh] max-w-6xl flex-col items-center justify-center px-4 py-20 text-center md:py-28">
      <p class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-black/30 px-3.5 py-1.5 text-[0.68rem] font-semibold uppercase tracking-[0.18em] text-ash-200 backdrop-blur-md">
        Wiki & Field Guide
        <span class="text-ash-500">·</span>
        <span class="text-amber-glow">Releases August 20, 2026</span>
      </p>

      <h1 class="mt-6 max-w-4xl text-4xl font-bold tracking-[-0.03em] text-ash-100 sm:text-5xl md:text-6xl">
        MORTAL SHELL 2 WIKI &amp; GUIDE
        <span class="mt-2 block bg-gradient-to-r from-amber-glow via-ember-soft to-amber-glow bg-clip-text text-transparent">
          RELEASE DATE · SHELLS · GUIDES
        </span>
      </h1>

      <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-ash-300 md:text-lg">
        Your complete guide to Cold Symmetry's soulslike sequel. Shells, weapons, bosses, Open Beta routes,
        and every fact tagged with a confirmation status.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="/download/" class="btn-primary">
          Download Open Beta →
        </a>
        <a href="/beginner-guide/" class="btn-ghost">
          Beginner first hours
        </a>
        <a href="/guide/" class="btn-ghost">
          All guides
        </a>
      </div>

      {!released && (
        <div class="mt-10">
          <Countdown />
        </div>
      )}

      <p class="mt-10 text-[0.68rem] font-semibold uppercase tracking-[0.2em] text-ash-500">
        Start with verified pages below
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 pb-16 pt-12 md:pt-16">
    <!-- Open Beta conversion band -->
    <section class="surface-card overflow-hidden p-6 md:p-8">
      <div class="grid gap-7 lg:grid-cols-[1.35fr_1fr] lg:items-center">
        <div>
          <p class="section-kicker">Official Steam only</p>
          <h2 class="section-title mt-3">Play the Mortal Shell II Open Beta</h2>
          <p class="mt-3 max-w-2xl text-ash-300">
            Install from Steam, check minimum PC requirements (SSD required), and review the mature content description before you launch. This wiki never hosts game files.
          </p>
          <ul class="mt-5 grid gap-2 text-sm text-ash-300 sm:grid-cols-2">
            <li class="rounded-lg border border-white/5 bg-white/[0.02] px-3 py-2">Windows 10/11 · 16 GB RAM · DX12</li>
            <li class="rounded-lg border border-white/5 bg-white/[0.02] px-3 py-2">RTX 2060 SUPER / RX 6600 class GPU</li>
            <li class="rounded-lg border border-white/5 bg-white/[0.02] px-3 py-2">30 GB free space · SSD required</li>
            <li class="rounded-lg border border-white/5 bg-white/[0.02] px-3 py-2">Violence, blood sprays, executions, firearms</li>
          </ul>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="/download/" class="btn-primary !px-4 !py-2.5 text-sm">Open download hub</a>
            <a
              href={SITE.openBetaUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-ghost !px-4 !py-2.5 text-sm"
            >
              Steam Open Beta ↗
            </a>
            <a href="/pc-settings/" class="btn-ghost !px-4 !py-2.5 text-sm">Full system requirements</a>
          </div>
        </div>

        <a href="/map/" class="group block overflow-hidden rounded-xl border border-white/10 bg-ash-950">
          <img
            src={SITE_IMAGES.worldMapCover.src}
            alt={SITE_IMAGES.worldMapCover.alt}
            width={SITE_IMAGES.worldMapCover.width}
            height={SITE_IMAGES.worldMapCover.height}
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          />
          <div class="border-t border-white/5 px-4 py-3.5">
            <p class="text-sm font-semibold text-ash-100 group-hover:text-amber-glow">World map overview</p>
            <p class="mt-1 text-xs text-ash-400">Open the map page for early regions and named landmarks.</p>
          </div>
        </a>
      </div>
    </section>

    <!-- Trust -->
    <section class="mt-14">
      <div class="surface-card p-6 md:p-8">
        <p class="section-kicker">Why this wiki</p>
        <h2 class="section-title mt-3">Every fact is sourced</h2>
        <p class="mt-3 max-w-3xl text-ash-400">
          Before launch, most guides mix confirmed details with forum rumours. We don't. Each entry is tagged so you always know what's verified and what isn't:
        </p>
        <div class="mt-5 flex flex-wrap gap-2">
          <StatusBadge status="official" />
          <StatusBadge status="beta" />
          <StatusBadge status="trailer" />
          <StatusBadge status="prequel" />
          <StatusBadge status="unconfirmed" />
        </div>
      </div>
    </section>

    <!-- Essential guides -->
    <section class="mt-16">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
        <div>
          <p class="section-kicker">Essential guides</p>
          <h2 class="section-title mt-3">Where to begin</h2>
        </div>
        <a href="/guide/" class="text-sm font-medium text-amber-glow hover:text-ember-soft">All guides →</a>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        {
          startHere.map((s) => (
            <a href={s.href} class="surface-card group flex h-full overflow-hidden">
              <div class="w-[38%] min-w-[7.5rem] overflow-hidden bg-ash-950">
                <img
                  src={s.cover}
                  alt={`${s.title} guide cover`}
                  width="480"
                  height="360"
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                />
              </div>
              <div class="flex flex-1 flex-col p-4 md:p-5">
                <h3 class="text-base font-semibold text-ash-100 group-hover:text-amber-glow md:text-lg">{s.title}</h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-ash-400">{s.desc}</p>
                <span class="mt-4 text-sm font-medium text-amber-glow/90">Open page →</span>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Explore categories -->
    <section class="mt-16">
      <p class="section-kicker">Browse the wiki</p>
      <h2 class="section-title mt-3">Explore by category</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          categories.map((c) => (
            <a href={c.href} class="surface-card group flex h-full flex-col p-5">
              <span class="text-lg font-semibold text-ash-100 group-hover:text-amber-glow">{c.title}</span>
              <span class="mt-2 flex-1 text-sm leading-relaxed text-ash-400">{c.desc}</span>
              {c.count !== null && (
                <span class="mt-4 text-xs uppercase tracking-[0.14em] text-ash-500">
                  {c.count} {c.countLabel}
                </span>
              )}
            </a>
          ))
        }
      </div>
    </section>

    <!-- Featured imagery -->
    <section class="mt-16">
      <p class="section-kicker">Visual archive</p>
      <h2 class="section-title mt-3">Featured imagery</h2>
      <p class="mt-3 max-w-3xl text-ash-400">
        Screenshots from Steam and official Cold Symmetry media. Every image is attributed so you know whether it comes from the store page or the developer site.
      </p>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        <MediaFigure
          src={SITE_IMAGES.officialKeyart1.src}
          alt={SITE_IMAGES.officialKeyart1.alt}
          width={SITE_IMAGES.officialKeyart1.width}
          height={SITE_IMAGES.officialKeyart1.height}
          credit={SITE_IMAGES.officialKeyart1.credit}
        />
        <MediaFigure
          src={SITE_IMAGES.heroCombat.src}
          alt={SITE_IMAGES.heroCombat.alt}
          width={SITE_IMAGES.heroCombat.width}
          height={SITE_IMAGES.heroCombat.height}
          credit={SITE_IMAGES.heroCombat.credit}
        />
        <MediaFigure
          src={SITE_IMAGES.weaponsCloseup.src}
          alt={SITE_IMAGES.weaponsCloseup.alt}
          width={SITE_IMAGES.weaponsCloseup.width}
          height={SITE_IMAGES.weaponsCloseup.height}
          credit={SITE_IMAGES.weaponsCloseup.credit}
        />
        <MediaFigure
          src={SITE_IMAGES.cathedralBoss.src}
          alt={SITE_IMAGES.cathedralBoss.alt}
          width={SITE_IMAGES.cathedralBoss.width}
          height={SITE_IMAGES.cathedralBoss.height}
          credit={SITE_IMAGES.cathedralBoss.credit}
        />
      </div>
    </section>

    <!-- Release info -->
    <section class="surface-card mt-16 p-6 md:p-8">
      <p class="section-kicker">Release desk</p>
      <h2 class="section-title mt-3">Release information</h2>
      <dl class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-white/5 bg-white/[0.02] p-4">
          <dt class="text-xs uppercase tracking-[0.14em] text-ash-500">Release date</dt>
          <dd class="mt-2 text-ash-100">August 20, 2026</dd>
        </div>
        <div class="rounded-xl border border-white/5 bg-white/[0.02] p-4">
          <dt class="text-xs uppercase tracking-[0.14em] text-ash-500">Platforms</dt>
          <dd class="mt-2 text-ash-100">Steam · PS5 · Xbox Series X|S</dd>
        </div>
        <div class="rounded-xl border border-white/5 bg-white/[0.02] p-4">
          <dt class="text-xs uppercase tracking-[0.14em] text-ash-500">Developer</dt>
          <dd class="mt-2 text-ash-100">{SITE.developer}</dd>
        </div>
        <div class="rounded-xl border border-white/5 bg-white/[0.02] p-4">
          <dt class="text-xs uppercase tracking-[0.14em] text-ash-500">Publisher</dt>
          <dd class="mt-2 text-ash-100">{SITE.publisher}</dd>
        </div>
      </dl>
      <p class="mt-5 text-sm text-ash-400">
        Full breakdown:
        <a href="/release-date/" class="text-amber-glow hover:text-ember-soft">release date guide</a>
        ·
        <a href="/editions/" class="text-amber-glow hover:text-ember-soft">editions</a>
        ·
        <a href="/beginner-guide/" class="text-amber-glow hover:text-ember-soft">beginner guide</a>
      </p>
    </section>
  </div>
</Layout>
